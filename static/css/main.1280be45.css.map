.familia {
  box-sizing: border-box;
  width: min(1080px, 100%);
  margin: 0 auto;
  padding: 108px 20px 48px;
  color: #f4f1ea;
}

.familia-encabezado {
  width: min(680px, 100%);
  margin: 8px auto 36px;
  text-align: center;
}

.familia-encabezado h1 {
  margin: 0 0 16px;
  color: #f4f1ea;
  font-size: 2.05rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  line-height: 1.25;
}

.familia-encabezado p {
  margin: 6px 0 0;
  color: #c4b49a;
  font-size: 0.74rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  line-height: 1.6;
  text-transform: uppercase;
}

.familia-encabezado::after {
  content: "";
  display: block;
  width: 42px;
  height: 1px;
  margin: 22px auto 0;
  background: rgba(196, 180, 154, 0.75);
}

.familia-seccion {
  margin: 56px 0 18px;
  color: #c4b49a;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  line-height: 1.5;
  text-align: center;
  text-transform: uppercase;
}

.familia-intro {
  max-width: 760px;
  margin: 0 auto 14px;
  color: rgba(236, 236, 236, 0.86);
  font-size: 0.95rem;
  line-height: 1.65;
  text-align: center;
}

.familia-intro:last-of-type {
  margin-bottom: 22px;
}

.familia-divisiones,
.familia-equipos {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 14px;
  align-items: stretch;
}

.familia-card {
  box-sizing: border-box;
  padding: 18px 18px 16px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 16px;
  background: rgba(26, 38, 52, 0.16);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
  text-align: left;
  transition: transform 0.22s ease, border-color 0.22s ease;
}

.familia-card:hover {
  transform: translateY(-6px);
  border-color: rgba(255, 255, 255, 0.32);
}

.familia-card h2,
.familia-card h3 {
  margin: 0 0 12px;
  color: #f4f1ea;
  font-size: 1.05rem;
  font-weight: 600;
  line-height: 1.35;
}

.familia-card p {
  margin: 0;
  color: rgba(236, 236, 236, 0.86);
  font-size: 0.92rem;
  line-height: 1.6;
}

@media (max-width: 600px) {
  .familia {
    padding: 96px 12px 32px;
  }

  .familia-encabezado h1 {
    font-size: 1.6rem;
  }

  .familia-divisiones,
  .familia-equipos {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  .familia-card {
    transition: none;
  }

  .familia-card:hover {
    transform: none;
  }
}
